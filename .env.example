#* export $(grep -v '^#' .env.example | xargs)

# Client HTTP base. Default `/api` uses the Nitro BFF (same origin).
NUXT_PUBLIC_API_BASE=/api

# Server-only upstream for the BFF proxy (not exposed to the browser).
NUXT_API_UPSTREAM=http://0.0.0.0:9090/api

# Optional: call the API directly (skips the BFF).
# NUXT_PUBLIC_API_BASE=http://0.0.0.0:9090/api
